<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ad Editor | Sandesh AI</title>
    <link rel="icon" href="/static/favicon.jpeg" type="image/jpeg">
    <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&display=swap"
        rel="stylesheet">
    <!-- Preload Custom Gujarati Fonts -->
    <link rel="preload" href="/static/fonts/BMA_____.TTF" as="font" type="font/ttf" crossorigin="anonymous">
    <link rel="preload" href="/static/fonts/BGOT____.TTF" as="font" type="font/ttf" crossorigin="anonymous">
    <link rel="preload" href="/static/fonts/BGOTB___.TTF" as="font" type="font/ttf" crossorigin="anonymous">
    <!-- Include Fabric.js, jsPDF, UTIF & HTML2Canvas -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/fabric.js/5.3.1/fabric.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/utif@3.1.0/UTIF.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="/static/js/unicode_to_gopika.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#fef2f2',
                            100: '#fee2e2',
                            500: '#e82526',
                            600: '#990d0e',
                            700: '#991b1b',
                        },
                    }
                }
            }
        }
    </script>
    <style>
        @font-face {
            font-family: 'BMA';
            src: url('/static/fonts/BMA_____.TTF') format('truetype');
            font-weight: normal;
            font-style: normal;
        }

        @font-face {
            font-family: 'BGOT';
            src: url('/static/fonts/BGOT____.TTF') format('truetype');
            font-weight: normal;
            font-style: normal;
        }

        @font-face {
            font-family: 'BGOTB';
            src: url('/static/fonts/BGOTB___.TTF') format('truetype');
            font-weight: normal;
            font-style: normal;
        }

        @font-face {
            font-family: 'Gopika';
            src: url('/static/fonts/BGOT____.TTF') format('truetype');
            font-weight: normal;
            font-style: normal;
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        html,
        body {
            overflow: hidden !important;
            height: 100vh !important;
            width: 100vw !important;
            margin: 0;
            padding: 0;
        }

        /* NEWSPAPER STYLES */
        .ad-preview-html {
            background-color: #fff;
            color: #000;
            font-family: 'BGOT', sans-serif;
            position: relative;
            box-sizing: border-box;
            border: 4px solid #000;
        }
        .ad-heading-box {
            background-color: #000;
            color: #fff;
            font-family: 'BMA', sans-serif;
            text-align: center;
            width: 100%;
        }
        .ad-columns-container {
            width: 100%;
            column-count: 2;
            column-gap: 10px;
            column-rule: 1px solid #000;
        }
        .ad-paragraph {
            text-align: justify;
            text-align-last: left;
            hyphens: manual;
            word-break: normal;
            overflow-wrap: break-word;
            margin-bottom: 0;
            line-height: 1.15;
            margin-top: 0;
            widows: 1;
            orphans: 1;
        }
        .notice-date {
            text-align: left;
            text-align-last: left;
            break-inside: avoid;
            margin-bottom: 0;
        }
        .advocate-block {
            text-align: right;
            text-align-last: right;
            break-inside: avoid;
            margin-bottom: 0;
        }
        .advocate-block p {
            margin: 0;
            text-align: right;
            text-align-last: right;
        }
    </style>
</head>

<body class="bg-slate-900 font-sans text-slate-100 antialiased h-screen w-screen flex flex-col overflow-hidden">

    <!-- Font Preloaders -->
    <div style="font-family: 'BMA'; position: absolute; left: -9999px; visibility: hidden;">BMA Preload</div>
    <div style="font-family: 'BGOT'; position: absolute; left: -9999px; visibility: hidden;">BGOT Preload</div>
    <div style="font-family: 'BGOTB'; position: absolute; left: -9999px; visibility: hidden;">BGOTB Preload</div>

    <!-- Top Navigation Header -->
    <header class="h-14 bg-slate-950 border-b border-slate-800 flex items-center justify-between px-4 z-30 shrink-0">
        <div class="flex items-center gap-4">
            <a href="/advt" class="flex items-center gap-2 text-slate-400 hover:text-white font-semibold text-xs transition-colors px-2.5 py-1.5 rounded-lg border border-slate-800 hover:bg-slate-800">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Back to ADVT List
            </a>
            <div class="h-5 w-px bg-slate-800"></div>
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <h1 class="text-sm font-bold text-white tracking-wide">Full Page Ad Editor</h1>
                <span id="advtMetaBadge" class="text-xs text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800 font-mono">Loading...</span>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <!-- Downloads -->
            <div class="flex items-center bg-slate-900 border border-slate-800 rounded-lg p-1 gap-1">
                <button type="button" onclick="downloadCanvas('png')"
                    class="px-3 py-1 bg-brand-600 hover:bg-brand-700 text-white rounded text-xs font-bold transition-all shadow flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                    PNG
                </button>
                <button type="button" onclick="downloadCanvas('pdf')"
                    class="px-3 py-1 bg-purple-600 hover:bg-purple-700 text-white rounded text-xs font-bold transition-all shadow flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                    PDF
                </button>
                <button type="button" onclick="downloadCanvas('tif')"
                    class="px-3 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded text-xs font-bold transition-all shadow flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    TIF
                </button>
            </div>

            <div class="h-5 w-px bg-slate-800"></div>

            <button type="button" onclick="saveEditorChanges()"
                class="px-5 py-1.5 bg-brand-600 hover:bg-brand-700 text-white rounded-lg text-xs font-bold tracking-wide transition-all shadow shadow-brand-900/30 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                Save Changes
            </button>
        </div>
    </header>

    <!-- Main Full Page Editor Workspace -->
    <div class="flex-1 flex overflow-hidden relative">

        <!-- Left Controls & Settings Sidebar -->
        <aside class="w-[450px] bg-slate-900 border-r border-slate-800 flex flex-col shrink-0 overflow-hidden shadow-2xl z-20">
            <!-- Sidebar Header Tabs -->
            <div class="p-3 border-b border-slate-800 bg-slate-950 flex items-center justify-between">
                <span class="text-xs font-bold tracking-wider uppercase text-slate-400">Layout & Text Inspector</span>
                <span id="saveStatusIndicator" class="text-[11px] font-semibold text-slate-500">Auto-sync enabled</span>
            </div>

            <!-- Scrollable Settings Container -->
            <div class="flex-1 overflow-y-auto p-4 space-y-5 no-scrollbar text-xs">

                <!-- 1. COLUMN LAYOUT CONTROL (1, 2, 3, 4 COLUMNS) -->
                <div class="bg-slate-950 border border-slate-800 rounded-xl p-3.5 space-y-3">
                    <div class="flex items-center justify-between">
                        <label class="font-bold text-slate-200 tracking-wide uppercase text-[11px] flex items-center gap-1.5">
                            <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m3 9v-5m0 0V9m0 2h4m-4 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2Z"></path></svg>
                            Column Layout
                        </label>
                        <span class="text-[10px] bg-brand-950 text-brand-400 px-2 py-0.5 rounded font-mono font-bold border border-brand-800/50">1 - 4 Cols</span>
                    </div>

                    <!-- Column Count Buttons -->
                    <div class="grid grid-cols-4 gap-1.5 p-1 bg-slate-900 border border-slate-800 rounded-lg">
                        <button type="button" id="colBtn1" onclick="setColumnCount(1)" class="py-1.5 rounded text-xs font-bold transition-all text-slate-400 hover:text-white">1 Col</button>
                        <button type="button" id="colBtn2" onclick="setColumnCount(2)" class="py-1.5 rounded text-xs font-bold transition-all text-slate-400 hover:text-white">2 Cols</button>
                        <button type="button" id="colBtn3" onclick="setColumnCount(3)" class="py-1.5 rounded text-xs font-bold transition-all text-slate-400 hover:text-white">3 Cols</button>
                        <button type="button" id="colBtn4" onclick="setColumnCount(4)" class="py-1.5 rounded text-xs font-bold transition-all text-slate-400 hover:text-white">4 Cols</button>
                    </div>

                    <!-- Column Sizing Mode & Width/Height Controls -->
                    <div class="space-y-2 pt-1 border-t border-slate-900">
                        <div class="flex items-center justify-between">
                            <span class="text-slate-400">Total Ad Width (cm):</span>
                            <div class="flex items-center gap-1">
                                <button type="button" onclick="adjustAdWidth(-0.2)" class="w-6 h-6 rounded bg-slate-800 hover:bg-slate-700 text-white font-bold flex items-center justify-center">-</button>
                                <input type="number" id="adWidthInput" step="0.1" min="3.0" max="30.0" onchange="setAdWidth(this.value)" class="w-16 bg-slate-900 border border-slate-700 rounded px-1.5 py-0.5 text-center text-white font-semibold outline-none focus:border-brand-500">
                                <button type="button" onclick="adjustAdWidth(0.2)" class="w-6 h-6 rounded bg-slate-800 hover:bg-slate-700 text-white font-bold flex items-center justify-center">+</button>
                            </div>
                        </div>

                        <div class="flex items-center justify-between pt-0.5">
                            <span class="text-slate-400">Total Ad Height (cm):</span>
                            <div class="flex items-center gap-1">
                                <button type="button" onclick="adjustAdHeight(-0.5)" class="w-6 h-6 rounded bg-slate-800 hover:bg-slate-700 text-white font-bold flex items-center justify-center">-</button>
                                <input type="number" id="adHeightInput" step="0.1" min="4.0" max="50.0" onchange="setAdHeight(this.value)" class="w-16 bg-slate-900 border border-slate-700 rounded px-1.5 py-0.5 text-center text-white font-semibold outline-none focus:border-brand-500">
                                <button type="button" onclick="adjustAdHeight(0.5)" class="w-6 h-6 rounded bg-slate-800 hover:bg-slate-700 text-white font-bold flex items-center justify-center">+</button>
                            </div>
                        </div>

                        <div class="pt-0.5 flex gap-1">
                            <button type="button" onclick="autoFitAdHeight()" class="flex-1 py-1 bg-slate-800 hover:bg-slate-700 text-brand-400 hover:text-brand-300 font-bold rounded text-[11px] flex items-center justify-center gap-1 transition-colors border border-slate-700/60" title="Shrink box to fit text">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path></svg>
                                Auto-Fit Box
                            </button>
                            <button type="button" onclick="autoStretchLineHeight()" class="flex-1 py-1 bg-slate-800 hover:bg-slate-700 text-brand-400 hover:text-brand-300 font-bold rounded text-[11px] flex items-center justify-center gap-1 transition-colors border border-slate-700/60" title="Adjust Line Height to exactly fill the box">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
                                Stretch Text
                            </button>
                        </div>


                        <!-- Equal Widths Toggle -->
                        <div class="flex items-center justify-between pt-1">
                            <label class="text-slate-300 flex items-center gap-2 cursor-pointer">
                                <input type="checkbox" id="equalColWidthsToggle" checked onchange="toggleEqualColWidths(this.checked)" class="rounded bg-slate-900 border-slate-700 text-brand-600 focus:ring-0">
                                <span>Equal Column Widths</span>
                            </label>
                        </div>

                        <!-- Per Column Custom Widths Container -->
                        <div id="customColWidthsContainer" class="space-y-1.5 pt-1"></div>

                        <!-- Column Balance (+1 / -1) & Gutter Line Options -->
                        <div class="flex items-center justify-between pt-2 border-t border-slate-900">
                            <span class="text-slate-400">Balance Columns:</span>
                            <div class="flex items-center gap-1.5">
                                <button type="button" onclick="adjustLayoutOffset(-1)" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-white rounded font-bold transition-all flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"></path></svg>
                                    -1
                                </button>
                                <span id="layoutOffsetDisplay" class="font-mono text-brand-400 font-bold px-1.5">0</span>
                                <button type="button" onclick="adjustLayoutOffset(1)" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-white rounded font-bold transition-all flex items-center gap-1">
                                    +1
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"></path></svg>
                                </button>
                            </div>
                        </div>

                        <!-- Column Gutter Rule Width -->
                        <div class="flex items-center justify-between pt-1">
                            <span class="text-slate-400">Column Rule Line:</span>
                            <select id="colRuleSelect" onchange="setColumnRule(this.value)" class="bg-slate-900 border border-slate-700 rounded px-2 py-1 text-white outline-none">
                                <option value="1">Solid Line (1px)</option>
                                <option value="2">Thick Line (2px)</option>
                                <option value="0">None / Hide Line</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- 2. BLACK HEADING BOX CONTROLS ("જાહેર નોટીસ") -->
                <div class="bg-slate-950 border border-slate-800 rounded-xl p-3.5 space-y-3">
                    <div class="flex items-center justify-between">
                        <label class="font-bold text-slate-200 tracking-wide uppercase text-[11px] flex items-center gap-1.5">
                            <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                            Black Heading Box ("જાહેર નોટિસ")
                        </label>
                    </div>

                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <span class="text-[11px] text-slate-400 block mb-1">Heading Layout:</span>
                            <div class="flex bg-slate-900 p-0.5 border border-slate-800 rounded-lg">
                                <button type="button" id="hLayoutLeftBtn" onclick="setHeadingLayout('left')" class="flex-1 py-1 text-[11px] font-bold rounded transition-all text-slate-400">1st Col</button>
                                <button type="button" id="hLayoutFullBtn" onclick="setHeadingLayout('full')" class="flex-1 py-1 text-[11px] font-bold rounded transition-all text-slate-400">Full Width</button>
                            </div>
                        </div>
                        <div>
                            <span class="text-[11px] text-slate-400 block mb-1">Box Height (px):</span>
                            <input type="number" id="headingHeightInput" min="20" max="250" value="25" onchange="setHeadingBgHeight(this.value)" class="w-full bg-slate-900 border border-slate-700 rounded px-2 py-1 text-center text-white font-semibold outline-none focus:border-brand-500">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-2 pt-1">
                        <div>
                            <span class="text-[11px] text-slate-400 block mb-1">Text Y Position (Offset):</span>
                            <input type="number" id="headingTextYInput" min="-50" max="150" value="0" onchange="setHeadingTextY(this.value)" class="w-full bg-slate-900 border border-slate-700 rounded px-2 py-1 text-center text-white font-semibold outline-none focus:border-brand-500">
                        </div>
                        <div>
                            <span class="text-[11px] text-slate-400 block mb-1">Heading Font Size (pt):</span>
                            <input type="number" id="headingFontSizeInput" step="0.5" min="10" max="72" value="20" onchange="setHeadingFontSize(this.value)" class="w-full bg-slate-900 border border-slate-700 rounded px-2 py-1 text-center text-white font-semibold outline-none focus:border-brand-500">
                    </div>
                </div>

                <!-- 3. TYPOGRAPHY & SPACING CONTROLS (LINE HEIGHT, LETTER SPACING, WORD SPACING) -->
                <div class="bg-slate-950 border border-slate-800 rounded-xl p-3.5 space-y-3">
                    <div class="flex items-center justify-between">
                        <label class="font-bold text-slate-200 tracking-wide uppercase text-[11px] flex items-center gap-1.5">
                            <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                            Typography & Line Height Controls
                        </label>
                    </div>

                    <!-- Line Height / Line Spacing Control -->
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400 text-xs">Line Height (Spacing):</span>
                        <div class="flex items-center gap-1">
                            <button type="button" onclick="adjustLineHeight(-0.05)" class="w-6 h-6 rounded bg-slate-800 hover:bg-slate-700 text-white font-bold flex items-center justify-center">-</button>
                            <input type="number" id="lineHeightInput" step="0.05" min="0.80" max="3.00" value="1.15" onchange="setLineHeight(this.value)" class="w-16 bg-slate-900 border border-slate-700 rounded px-1.5 py-0.5 text-center text-white font-semibold outline-none focus:border-brand-500">
                            <button type="button" onclick="adjustLineHeight(0.05)" class="w-6 h-6 rounded bg-slate-800 hover:bg-slate-700 text-white font-bold flex items-center justify-center">+</button>
                        </div>
                    </div>

                    <!-- Letter / Character Spacing Control -->
                    <div class="flex items-center justify-between pt-1 border-t border-slate-900">
                        <span class="text-slate-400 text-xs">Letter Spacing (Char):</span>
                        <div class="flex items-center gap-1">
                            <button type="button" onclick="adjustCharSpacing(-5)" class="w-6 h-6 rounded bg-slate-800 hover:bg-slate-700 text-white font-bold flex items-center justify-center">-</button>
                            <input type="number" id="charSpacingInput" step="5" min="-50" max="300" value="0" onchange="setCharSpacing(this.value)" class="w-16 bg-slate-900 border border-slate-700 rounded px-1.5 py-0.5 text-center text-white font-semibold outline-none focus:border-brand-500">
                            <button type="button" onclick="adjustCharSpacing(5)" class="w-6 h-6 rounded bg-slate-800 hover:bg-slate-700 text-white font-bold flex items-center justify-center">+</button>
                        </div>
                    </div>

                    <!-- Word Spacing Control -->
                    <div class="flex items-center justify-between pt-1 border-t border-slate-900">
                        <span class="text-slate-400 text-xs">Word Spacing (Space):</span>
                        <div class="flex items-center gap-1">
                            <button type="button" onclick="adjustWordSpacing(-2)" class="w-6 h-6 rounded bg-slate-800 hover:bg-slate-700 text-white font-bold flex items-center justify-center">-</button>
                            <input type="number" id="wordSpacingInput" step="2" min="-20" max="100" value="0" onchange="setWordSpacing(this.value)" class="w-16 bg-slate-900 border border-slate-700 rounded px-1.5 py-0.5 text-center text-white font-semibold outline-none focus:border-brand-500">
                            <button type="button" onclick="adjustWordSpacing(2)" class="w-6 h-6 rounded bg-slate-800 hover:bg-slate-700 text-white font-bold flex items-center justify-center">+</button>
                        </div>
                    </div>
                </div>

                <!-- 4. BHASHA BHARATI (RAMINGTON TYPEWRITER) COMPATIBILITY TOGGLE -->
                <div class="bg-gradient-to-r from-slate-950 to-brand-950/40 border border-brand-800/40 rounded-xl p-3.5 space-y-2">
                    <div class="flex items-center justify-between">
                        <label class="text-slate-200 font-bold flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" id="bhashaBharatiToggle" onchange="toggleBhashaBharatiMode(this.checked)" class="rounded bg-slate-900 border-brand-700 text-brand-600 focus:ring-0 w-4 h-4">
                            <span class="text-xs">Input from Bhasha Bharati (Remington)</span>
                        </label>
                        <span class="text-[10px] bg-brand-600 text-white px-2 py-0.5 rounded font-bold">TYPEWRITER</span>
                    </div>
                    <p class="text-[11px] text-slate-400 leading-snug">
                        Operators typing from Bhasha Bharati Premier Pack (Remington Gujarati layout) can paste/type text directly. Converts ASCII character codes to clean Gujarati Unicode without broken matras/conjuncts.
                    </p>
                </div>

                <!-- 4. DYNAMIC TEXT BLOCKS & PER-LINE FORMATTING CONTROLS -->
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-slate-200 tracking-wide uppercase text-[11px]">Text Content & Line Formatting</span>
                        <button type="button" onclick="updateCanvasFromText()" class="text-xs text-brand-400 hover:text-brand-300 font-bold flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                            Sync to Canvas
                        </button>
                    </div>

                    <div id="editBlocksContainer" class="space-y-4">
                        <!-- Dynamic text blocks will be inserted here -->
                    </div>
                </div>

            </div>
        </aside>

        <!-- Right Canvas Viewport Area -->
        <main class="flex-1 flex flex-col bg-slate-950 relative overflow-hidden">

            <!-- Top Canvas Controls Toolbar (Zoom, Fit, View Modes) -->
            <div class="h-11 bg-slate-900 border-b border-slate-800 flex items-center justify-between px-4 z-20 shrink-0">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-semibold text-slate-400">Zoom:</span>
                    <button type="button" onclick="zoomStep(-0.1)" class="w-7 h-7 rounded bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs flex items-center justify-center transition-all">-</button>
                    <input type="range" id="zoomRangeSlider" min="10" max="500" value="100" oninput="onZoomSliderInput(this.value)" class="w-32 accent-brand-600 cursor-pointer">
                    <button type="button" onclick="zoomStep(0.1)" class="w-7 h-7 rounded bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs flex items-center justify-center transition-all">+</button>
                    
                    <div class="flex items-center bg-slate-950 border border-slate-800 rounded px-2 py-0.5">
                        <input type="number" id="zoomPercentInput" min="10" max="1000" value="100" onchange="onZoomInputPercent(this.value)" class="w-12 bg-transparent text-center font-mono font-bold text-xs text-white outline-none">
                        <span class="text-xs font-mono text-slate-400">%</span>
                    </div>

                    <div class="h-4 w-px bg-slate-800 mx-1"></div>

                    <button type="button" onclick="setCanvasZoomPreset(1.0)" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded text-xs font-semibold transition-all">100%</button>
                    <button type="button" onclick="fitCanvasToWidth()" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded text-xs font-semibold transition-all">Fit Width</button>
                    <button type="button" onclick="fitCanvasToPage()" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded text-xs font-semibold transition-all">Fit Page</button>
                </div>

                <div class="flex items-center gap-3">
                    <span class="text-[11px] text-slate-400 flex items-center gap-1 font-mono">
                        <svg class="w-3.5 h-3.5 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        300 DPI High-Res Vector Canvas | Ctrl+Wheel to Zoom
                    </span>
                </div>
            </div>

            <!-- Canvas Scroll & Viewport Area -->
            <div id="canvasScrollArea" class="flex-1 overflow-y-auto overflow-x-auto p-8 flex justify-center items-start relative select-none">
                <div id="canvasInner" class="my-6 relative shadow-2xl transition-all duration-75">
                    <div id="canvasWrapper" class="relative inline-block border border-slate-800 bg-white shadow-2xl rounded mb-12">
                        <div id="advtHtmlWrapper" style="transform-origin: top left;">
                            <div id="advtHtmlContainer" class="ad-preview-html"></div>
                        </div>
                        <canvas id="advtCanvas" style="display:none;"></canvas>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Hidden Storage Input -->
    <input type="hidden" id="editAdvtId" value="{{ advt_id }}">
    <input type="hidden" id="editTranslationText" value="">

    <!-- Full Editor Script Logic -->
    <script>
        const CURRENT_ADVT_ID = "{{ advt_id }}";
        let advtData = null;
        let fabricCanvas = null;

        // Editor layout & column state
        window.customColumnCount = 2; // Default 2 columns for legal notice
        window.customAdWidth = 8.0; // Default ad width in cm
        window.customColWidths = []; // Per-column widths in cm
        window.equalColWidths = true;
        window.customBorderHeight = null;
        window.currentLayoutOffset = 0;
        window.canvasZoom = 1.0;
        window.bhashaBharatiMode = false;
        window.columnRuleWidth = 1;

        // Typography & Spacing State
        window.customLineHeight = 1.15;
        window.customCharSpacing = 0;
        window.customWordSpacing = 0;

        const BASE_DPI = 300;
        const DPI_SCALE = BASE_DPI / 96; // 3.125
        const PT_TO_PX = (BASE_DPI / 72) * 0.85; // ~3.5416 px per pt

        // Ensure custom fonts are loaded before drawing canvas
        async function ensureFontsLoaded() {
            try {
                await document.fonts.ready;
                const fonts = ['BMA', 'BGOT', 'BGOTB'];
                for (const font of fonts) {
                    await document.fonts.load(`16px "${font}"`);
                }
            } catch (e) {
                console.warn("Font preloading error:", e);
            }
        }

        // Bhasha Bharati / Remington Typewriter ASCII to Unicode Converter
        function bhashaBharatiRemingtonToGopika(str) {
            if (!str) return '';
            // Basic mapping for Remington legacy ASCII keys used in Bhasha Bharati Pack
            let remingtonMap = {
                'q': 'ત્', 'w': 'દ્', 'e': 'મા', 'r': 'ી', 't': 'ૂ', 'y': 'બ', 'u': 'હ', 'i': 'ગ', 'o': 'દ', 'p': 'જ',
                'a': 'ં', 's': 'ે', 'd': '્', 'f': 'િ', 'g': 'ુ', 'h': 'પ', 'j': 'ર', 'k': 'ક', 'l': 'ત',
                'z': '્ર', 'x': 'ં', 'c': 'મ', 'v': 'ન', 'b': 'વ', 'n': 'લ', 'm': 'સ',
                'Q': 'ફ', 'W': 'ઠ', 'E': 'ઓ', 'R': 'ી', 'T': 'ૂ', 'Y': 'ભ', 'U': 'ઙ', 'I': 'ઘ', 'O': 'ધ', 'P': 'ઝ',
                'A': 'ઁ', 'S': 'ૈ', 'D': '્', 'F': 'ર્િ', 'G': 'ુ', 'H': 'ફ', 'J': 'ૃ', 'K': 'ખ', 'L': 'થ',
                'Z': 'ર્', 'X': 'ં', 'C': 'ણ', 'V': 'ં', 'B': 'ળ', 'N': 'છ', 'M': 'શ'
            };
            let out = '';
            for (let i = 0; i < str.length; i++) {
                let ch = str[i];
                out += remingtonMap[ch] || ch;
            }
            return out;
        }

        // Font & Character Parser (BMA for Heading, BGOT for Paragraph, BGOTB for Bold)
        function parseInlineBoldAndFont(text, defaultWeight, baseFont = 'BGOT', initialIsBold = false) {
            let cleanText = "";
            let isBold = initialIsBold;
            let styles = {};
            let pIdx = 0;
            let cIdx = 0;

            for (let i = 0; i < text.length; i++) {
                if (text[i] === '*') {
                    isBold = !isBold;
                    continue;
                }
                cleanText += text[i];
                if (text[i] === '\n') {
                    pIdx++;
                    cIdx = 0;
                } else {
                    let fontName = baseFont;
                    if (baseFont === 'BMA') {
                        fontName = 'BMA';
                    } else if (isBold || defaultWeight === 'bold' || defaultWeight === '900') {
                        fontName = 'BGOTB';
                    } else {
                        fontName = 'BGOT';
                    }

                    if (fontName !== baseFont) {
                        if (!styles[pIdx]) styles[pIdx] = {};
                        styles[pIdx][cIdx] = { fontFamily: fontName };
                    }

                    cIdx++;
                }
            }
            return { cleanText, styles, finalIsBold: isBold };
        }

        // Initialize Page Data
        async function loadAdData() {
            try {
                const response = await fetch(`/api/advt`);
                if (!response.ok) throw new Error("Failed to fetch ads list");
                const advts = await response.json();
                advtData = advts.find(a => a._id === CURRENT_ADVT_ID);
                
                if (!advtData) {
                    alert("Ad not found!");
                    window.location.href = '/advt';
                    return;
                }

                // Update Header Metadata
                document.getElementById('advtMetaBadge').innerText = `${advtData.advt_type || 'Legal Notice'} (${advtData.width || 0}x${advtData.height || 0} ${advtData.unit || 'cm'})`;
                document.getElementById('editTranslationText').value = advtData.translated_text || '';

                // Parse Json Configs
                let parsedData = null;
                try { parsedData = JSON.parse(advtData.translated_text); } catch (e) { }

                if (parsedData) {
                    window.customColumnCount = parsedData.column_count || 2;
                    window.customAdWidth = parsedData.ad_width || advtData.width || (window.customColumnCount * 4.0);
                    window.currentLayoutOffset = parsedData.layout_offset || 0;
                    window.customBorderHeight = parsedData.border_height || null;
                    window.columnRuleWidth = parsedData.column_rule_width !== undefined ? parsedData.column_rule_width : 1;
                    window.customLineHeight = parsedData.line_height !== undefined ? parsedData.line_height : 1.15;
                    window.customCharSpacing = parsedData.char_spacing !== undefined ? parsedData.char_spacing : 0;
                    window.customWordSpacing = parsedData.word_spacing !== undefined ? parsedData.word_spacing : 0;
                    if (parsedData.col_widths && Array.isArray(parsedData.col_widths)) {
                        window.customColWidths = parsedData.col_widths;
                        window.equalColWidths = false;
                    }
                }

                renderLeftControlBlocks(advtData.translated_text);
                updateZoomButtons();
                updateColumnUI();

                // Build Canvas
                await buildCanvasPreview();
            } catch (err) {
                console.error("Error loading ad:", err);
                alert("Error loading ad: " + err.message);
            }
        }

        // Set Column Count with preset widths: 1 Col = 4 cm, 2 Cols = 8 cm, 3 Cols = 12 cm, 4 Cols = 16 cm
        function setColumnCount(count) {
            window.customColumnCount = count;
            if (count === 1) window.customAdWidth = 4.0;
            else if (count === 2) window.customAdWidth = 8.0;
            else if (count === 3) window.customAdWidth = 12.0;
            else if (count === 4) window.customAdWidth = 16.0;

            if (window.equalColWidths) {
                window.customColWidths = [];
            }
            
            // Auto fit height whenever column changes
            window.customAdHeight = null;
            window.customBorderHeight = null;
            
            updateColumnUI();
            updateCanvasFromText();
        }

        function updateColumnUI() {
            [1, 2, 3, 4].forEach(c => {
                const btn = document.getElementById(`colBtn${c}`);
                if (btn) {
                    if (c === window.customColumnCount) {
                        btn.className = "py-1.5 rounded text-xs font-bold transition-all bg-brand-600 text-white shadow";
                    } else {
                        btn.className = "py-1.5 rounded text-xs font-bold transition-all text-slate-400 hover:text-white";
                    }
                }
            });

            document.getElementById('adWidthInput').value = (window.customAdWidth || (window.customColumnCount * 4.0)).toFixed(1);
            const hInput = document.getElementById('adHeightInput');
            if (hInput) hInput.value = (window.customAdHeight || 8.0).toFixed(1);
            document.getElementById('equalColWidthsToggle').checked = window.equalColWidths;
            document.getElementById('colRuleSelect').value = window.columnRuleWidth;

            // Sync Typography inputs
            const lhIn = document.getElementById('lineHeightInput');
            if (lhIn) lhIn.value = (window.customLineHeight || 1.15).toFixed(2);
            const csIn = document.getElementById('charSpacingInput');
            if (csIn) csIn.value = window.customCharSpacing || 0;
            const wsIn = document.getElementById('wordSpacingInput');
            if (wsIn) wsIn.value = window.customWordSpacing || 0;

            // Render Custom Column Width Controls
            const container = document.getElementById('customColWidthsContainer');
            container.innerHTML = '';

            if (!window.equalColWidths && window.customColumnCount > 1) {
                for (let i = 0; i < window.customColumnCount; i++) {
                    let defaultWidth = (window.customAdWidth / window.customColumnCount).toFixed(1);
                    let val = window.customColWidths[i] || defaultWidth;
                    
                    const div = document.createElement('div');
                    div.className = "flex items-center justify-between text-slate-300 text-[11px] bg-slate-900 px-2 py-1 rounded border border-slate-800";
                    div.innerHTML = `
                        <span>Col ${i + 1} Width (cm):</span>
                        <input type="number" step="0.1" min="1.0" max="25.0" value="${val}" onchange="setSingleColWidth(${i}, this.value)" class="w-16 bg-slate-950 border border-slate-700 rounded px-1 text-center text-white font-semibold outline-none focus:border-brand-500">
                    `;
                    container.appendChild(div);
                }
            }
        }

        // Typography & Spacing Functions
        function adjustLineHeight(delta) {
            let current = parseFloat(document.getElementById('lineHeightInput').value) || window.customLineHeight || 1.15;
            current = Math.max(0.8, Math.min(3.0, Math.round((current + delta) * 100) / 100));
            setLineHeight(current);
        }

        function setLineHeight(val) {
            let num = parseFloat(val);
            if (isNaN(num) || num < 0.8) num = 1.15;
            window.customLineHeight = Math.max(0.8, Math.min(3.0, Math.round(num * 100) / 100));
            document.getElementById('lineHeightInput').value = window.customLineHeight.toFixed(2);
            updateCanvasFromText();
        }

        function adjustCharSpacing(delta) {
            let current = parseInt(document.getElementById('charSpacingInput').value) || window.customCharSpacing || 0;
            current = Math.max(-50, Math.min(300, current + delta));
            setCharSpacing(current);
        }

        function setCharSpacing(val) {
            let num = parseInt(val);
            if (isNaN(num)) num = 0;
            window.customCharSpacing = Math.max(-50, Math.min(300, num));
            document.getElementById('charSpacingInput').value = window.customCharSpacing;
            updateCanvasFromText();
        }

        function adjustWordSpacing(delta) {
            let current = parseInt(document.getElementById('wordSpacingInput').value) || window.customWordSpacing || 0;
            current = Math.max(-20, Math.min(100, current + delta));
            setWordSpacing(current);
        }

        function setWordSpacing(val) {
            let num = parseInt(val);
            if (isNaN(num)) num = 0;
            window.customWordSpacing = Math.max(-20, Math.min(100, num));
            document.getElementById('wordSpacingInput').value = window.customWordSpacing;
            updateCanvasFromText();
        }

        function toggleEqualColWidths(isEqual) {
            window.equalColWidths = isEqual;
            if (isEqual) window.customColWidths = [];
            updateColumnUI();
            updateCanvasFromText();
        }

        function setSingleColWidth(idx, val) {
            window.customColWidths[idx] = parseFloat(val) || 3.0;
            updateCanvasFromText();
        }

        function adjustAdWidth(delta) {
            let current = parseFloat(document.getElementById('adWidthInput').value) || window.customAdWidth || 6.2;
            current = Math.max(3.0, Math.min(30.0, Math.round((current + delta) * 10) / 10));
            setAdWidth(current);
        }

        function setAdWidth(val) {
            let num = parseFloat(val);
            if (isNaN(num) || num < 3.0) num = 6.2;
            window.customAdWidth = Math.max(3.0, Math.min(30.0, Math.round(num * 10) / 10));
            document.getElementById('adWidthInput').value = window.customAdWidth.toFixed(1);
            updateCanvasFromText();
        }

        function adjustAdHeight(delta) {
            let current = parseFloat(document.getElementById('adHeightInput').value) || window.customAdHeight || 8.0;
            current = Math.max(4.0, Math.min(50.0, Math.round((current + delta) * 10) / 10));
            setAdHeight(current);
        }

        function setAdHeight(val) {
            let num = parseFloat(val);
            if (isNaN(num) || num < 4.0) num = 8.0;
            window.customAdHeight = Math.max(4.0, Math.min(50.0, Math.round(num * 10) / 10));
            window.customBorderHeight = (window.customAdHeight / 2.54) * BASE_DPI;
            document.getElementById('adHeightInput').value = window.customAdHeight.toFixed(1);
            updateCanvasFromText();
        }

        function autoFitAdHeight() {
            window.customAdHeight = null;
            window.customBorderHeight = null;
            updateCanvasFromText();
        }

        function autoStretchLineHeight() {
            if (!window.customBorderHeight) return;
            
            let container = document.getElementById('advtHtmlContainer');
            let colsContainer = container.querySelector('.ad-columns-container');
            if (!colsContainer) return;
            
            let minLH = 0.8;
            let maxLH = 4.0;
            let bestLH = window.customLineHeight || 1.15;
            
            let paragraphs = container.querySelectorAll('.ad-paragraph, .notice-date, .advocate-block, .advocate-block p');
            
            for (let i = 0; i < 20; i++) {
                let midLH = (minLH + maxLH) / 2;
                paragraphs.forEach(p => p.style.lineHeight = midLH);
                
                // In column-fill: auto with a fixed height, overflow creates a new column horizontally
                let isOverflowing = colsContainer.scrollWidth > colsContainer.clientWidth;
                
                if (isOverflowing) {
                    maxLH = midLH;
                } else {
                    minLH = midLH;
                    bestLH = midLH;
                }
            }
            
            setLineHeight(bestLH);
        }


        function setColumnRule(val) {
            window.columnRuleWidth = parseInt(val) || 0;
            updateCanvasFromText();
        }

        function adjustLayoutOffset(delta) {
            window.currentLayoutOffset = (window.currentLayoutOffset || 0) + delta;
            document.getElementById('layoutOffsetDisplay').innerText = window.currentLayoutOffset > 0 ? '+' + window.currentLayoutOffset : window.currentLayoutOffset;
            updateCanvasFromText();
        }

        function toggleBhashaBharatiMode(isON) {
            window.bhashaBharatiMode = isON;
            if (isON) {
                // Automatically convert existing input text fields from Remington
                const container = document.getElementById('editBlocksContainer');
                const inputs = container.querySelectorAll('.block-editor-input');
                inputs.forEach(ta => {
                    ta.value = bhashaBharatiRemingtonToGopika(ta.value);
                });
                updateCanvasFromText();
            }
        }

        // Left Panel Settings Control Blocks
        function renderLeftControlBlocks(jsonStr) {
            const container = document.getElementById('editBlocksContainer');
            container.innerHTML = '';
            if (!jsonStr) return;

            try {
                let parsedData = JSON.parse(jsonStr);
                let blocks = [];
                if (Array.isArray(parsedData)) blocks = parsedData;
                else if (parsedData && Array.isArray(parsedData.gujarati_text)) blocks = parsedData.gujarati_text;

                if (blocks.length > 0) {
                    blocks.forEach((block, index) => {
                        const div = document.createElement('div');
                        div.className = 'bg-slate-950 border border-slate-800 rounded-xl p-3 space-y-2 relative';

                        const typeLabel = (block.type || 'Text Block').toUpperCase();
                        let textContent = block.text || '';
                        const fSize = block.font_size || (typeLabel === 'HEADING' ? 20 : 11);
                        const fAlign = block.text_align || (typeLabel === 'HEADING' ? 'center' : 'justify');
                        const fWeight = block.font_weight || 'normal';
                        const fLayout = block.layout_position || 'full';
                        const bgHeight = block.bg_height || 35;
                        const textOffsetY = block.text_offset_y !== undefined ? block.text_offset_y : 0;

                        if (typeLabel === 'HEADING') {
                            document.getElementById('headingHeightInput').value = bgHeight;
                            document.getElementById('headingTextYInput').value = textOffsetY;
                            document.getElementById('headingFontSizeInput').value = fSize;
                            setHeadingLayoutUI(fLayout);
                        }

                        div.innerHTML = `
                            <div class="flex items-center justify-between gap-2 border-b border-slate-900 pb-2">
                                <label class="text-[11px] font-bold text-brand-400 tracking-wider">${typeLabel}</label>
                                <div class="flex items-center gap-1 bg-slate-900 border border-slate-800 p-0.5 rounded-md">
                                    <span class="text-[10px] text-slate-400 font-medium px-1">Size:</span>
                                    <input type="number" step="0.5" class="block-format-size w-12 text-xs bg-slate-950 border border-slate-700 rounded px-1 text-center text-white outline-none" value="${fSize}" onchange="updateCanvasFromText()">
                                    <div class="w-px h-3.5 bg-slate-800 mx-0.5"></div>
                                    <button type="button" class="block-format-bold p-1 rounded text-slate-400 hover:text-white ${fWeight === 'bold' || fWeight === '900' ? 'bg-slate-800 text-white font-bold' : ''}" title="Toggle Bold">B</button>
                                    <div class="w-px h-3.5 bg-slate-800 mx-0.5"></div>
                                    <button type="button" data-align="left" class="block-format-align p-1 rounded ${fAlign === 'left' ? 'bg-slate-800 text-white' : 'text-slate-400'}"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h10M4 18h16"></path></svg></button>
                                    <button type="button" data-align="center" class="block-format-align p-1 rounded ${fAlign === 'center' ? 'bg-slate-800 text-white' : 'text-slate-400'}"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M7 12h10M4 18h16"></path></svg></button>
                                    <button type="button" data-align="right" class="block-format-align p-1 rounded ${fAlign === 'right' ? 'bg-slate-800 text-white' : 'text-slate-400'}"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M10 12h10M4 18h16"></path></svg></button>
                                    <button type="button" data-align="justify" class="block-format-align p-1 rounded ${fAlign === 'justify' ? 'bg-slate-800 text-white' : 'text-slate-400'}"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path></svg></button>
                                    <button type="button" data-align="force-justify" class="block-format-align px-1.5 py-0.5 rounded text-[9px] font-bold ${fAlign === 'force-justify' ? 'bg-brand-600 text-white' : 'text-slate-400 hover:text-white'}" title="FORCE JUSTIFY">FJ</button>
                                </div>
                            </div>
                            <textarea class="block-editor-input w-full p-2.5 bg-slate-900 border border-slate-800 rounded-lg text-slate-100 text-xs font-sans leading-relaxed resize-y focus:border-brand-500 outline-none" rows="4" data-index="${index}"></textarea>
                            <input type="hidden" class="block-format-bold-val" value="${fWeight}">
                            <input type="hidden" class="block-format-align-val" value="${fAlign}">
                            <input type="hidden" class="block-format-layout-val" value="${fLayout}">
                        `;
                        div.querySelector('textarea').value = textContent;

                        // Align buttons event
                        div.querySelectorAll('.block-format-align').forEach(btn => {
                            btn.addEventListener('click', function () {
                                div.querySelectorAll('.block-format-align').forEach(b => b.classList.remove('bg-slate-800', 'bg-brand-600', 'text-white'));
                                this.classList.add(this.dataset.align === 'force-justify' ? 'bg-brand-600' : 'bg-slate-800', 'text-white');
                                div.querySelector('.block-format-align-val').value = this.dataset.align;
                                updateCanvasFromText();
                            });
                        });

                        // Bold button event
                        div.querySelector('.block-format-bold').addEventListener('click', function () {
                            const valInput = div.querySelector('.block-format-bold-val');
                            if (valInput.value === 'bold' || valInput.value === '900') {
                                valInput.value = 'normal';
                                this.classList.remove('bg-slate-800', 'text-white');
                            } else {
                                valInput.value = 'bold';
                                this.classList.add('bg-slate-800', 'text-white');
                            }
                            updateCanvasFromText();
                        });

                        // Typing event (Bhasha Bharati support)
                        div.querySelector('.block-editor-input').addEventListener('input', function (e) {
                            if (window.bhashaBharatiMode) {
                                let curPos = this.selectionStart;
                                this.value = bhashaBharatiRemingtonToGopika(this.value);
                                this.selectionStart = this.selectionEnd = curPos;
                            }
                            updateCanvasFromText();
                        });

                        container.appendChild(div);
                    });
                }
            } catch (e) {
                console.error("Error rendering left control blocks:", e);
            }
        }

        function setHeadingLayout(mode) {
            setHeadingLayoutUI(mode);
            const hLayoutInput = document.querySelector('.block-format-layout-val');
            if (hLayoutInput) hLayoutInput.value = mode;
            updateCanvasFromText();
        }

        function setHeadingLayoutUI(mode) {
            const btnLeft = document.getElementById('hLayoutLeftBtn');
            const btnFull = document.getElementById('hLayoutFullBtn');
            if (btnLeft && btnFull) {
                if (mode === 'left') {
                    btnLeft.className = "flex-1 py-1 text-[11px] font-bold rounded transition-all bg-brand-600 text-white shadow";
                    btnFull.className = "flex-1 py-1 text-[11px] font-bold rounded transition-all text-slate-400 hover:text-white";
                } else {
                    btnFull.className = "flex-1 py-1 text-[11px] font-bold rounded transition-all bg-brand-600 text-white shadow";
                    btnLeft.className = "flex-1 py-1 text-[11px] font-bold rounded transition-all text-slate-400 hover:text-white";
                }
            }
        }

        function setHeadingBgHeight(val) {
            updateCanvasFromText();
        }

        function setHeadingTextY(val) {
            updateCanvasFromText();
        }

        function setHeadingFontSize(val) {
            const firstSizeInput = document.querySelector('.block-format-size');
            if (firstSizeInput) firstSizeInput.value = val;
            updateCanvasFromText();
        }

        // Build HTML Preview using CSS columns and manual rules
        async function buildCanvasPreview() {
            await ensureFontsLoaded();

            const container = document.getElementById('advtHtmlContainer');
            if (!container) return;

            if (!advtData) return;

            let widthInCm = window.customAdWidth || (advtData.width > 0 ? advtData.width : 6.2);
            let physicalScreenPx = (widthInCm / 2.54) * BASE_DPI;
            
            // Adjust height if auto fit is not set
            let heightInCm = window.customAdHeight || (advtData.height > 0 ? advtData.height : 8.0);
            let heightPx = (heightInCm / 2.54) * BASE_DPI;

            container.style.width = physicalScreenPx + 'px';
            container.style.height = 'auto'; // Always auto to let text balance perfectly
            if (window.customBorderHeight) {
                container.style.minHeight = window.customBorderHeight + 'px'; // Expand beyond user height if needed, but don't shrink below
            } else {
                container.style.minHeight = '0px'; // Allow shrinking below default height
            }
            let padPx = 10 * DPI_SCALE;
            container.style.padding = padPx + 'px';
            container.style.position = 'relative'; // for absolute column rules

            container.innerHTML = '';
            
            if (advtData.translated_text) {
                try {
                    let parsedData = JSON.parse(advtData.translated_text);
                    let blocks = Array.isArray(parsedData) ? parsedData : (parsedData.gujarati_text || []);

                    if (blocks.length > 0) {
                        const colCount = Math.max(1, Math.min(4, window.customColumnCount || 2));
                        
                        let headingBlock = blocks.find(b => (b.type || '').toLowerCase() === 'heading' || (b.text && b.text.includes('જાહેર નોટિસ')));
                        let advocateBlocks = blocks.filter(b => (b.type || '').toLowerCase() === 'advocate');
                        let contentBlocks = blocks.filter(b => b !== headingBlock && !advocateBlocks.includes(b));
                        
                        let colsContainer = document.createElement('div');
                        colsContainer.className = 'ad-columns-container';
                        colsContainer.style.columnCount = colCount;
                        colsContainer.style.columnGap = padPx + 'px';
                        colsContainer.style.columnRule = 'none'; // We will draw rules manually
                        
                        if (window.customBorderHeight) {
                            let offsetPx = (window.currentLayoutOffset || 0) * (5 * DPI_SCALE);
                            colsContainer.style.height = (window.customBorderHeight + offsetPx) + 'px';
                            colsContainer.style.columnFill = 'auto';
                        } else {
                            colsContainer.style.height = 'auto';
                            colsContainer.style.columnFill = 'balance';
                        }

                        if (headingBlock) {
                            let rawHText = headingBlock.text || 'જાહેર નોટિસ';
                            let convertedH = (typeof unicodeToGopika === 'function') ? unicodeToGopika(rawHText) : rawHText;
                            let hFontSize = (headingBlock.font_size || 20) * PT_TO_PX;
                            let hBgHeight = (headingBlock.bg_height ? parseFloat(headingBlock.bg_height) : 25) * DPI_SCALE;
                            
                            let hDiv = document.createElement('div');
                            hDiv.className = 'ad-heading-box';
                            hDiv.style.display = 'block';
                            hDiv.style.height = hBgHeight + 'px';
                            hDiv.style.minHeight = hBgHeight + 'px';
                            hDiv.style.lineHeight = hBgHeight + 'px';
                            hDiv.style.boxSizing = 'border-box';
                            hDiv.style.fontSize = hFontSize + 'px';
                            hDiv.style.marginBottom = padPx + 'px';
                            hDiv.style.width = 'auto'; // override CSS width 100% so margins work
                            
                            // Apply offset using a relative span for reliable html2canvas rendering
                            let offsetY = headingBlock.text_offset_y ? (parseFloat(headingBlock.text_offset_y) * DPI_SCALE) : 0;
                            hDiv.innerHTML = `<span style="position: relative; top: ${offsetY}px;">${convertedH}</span>`;
                            
                            let isLeftLayout = headingBlock.layout_position ? headingBlock.layout_position === 'left' : true;
                            if (isLeftLayout) {
                                hDiv.style.columnSpan = 'none';
                                hDiv.style.marginTop = -padPx + 'px';
                                hDiv.style.marginLeft = -padPx + 'px';
                                hDiv.style.marginRight = -(padPx / 2) + 'px';
                            } else {
                                hDiv.style.columnSpan = 'all';
                                hDiv.style.marginTop = -padPx + 'px';
                                hDiv.style.marginLeft = -padPx + 'px';
                                hDiv.style.marginRight = -padPx + 'px';
                            }
                            colsContainer.appendChild(hDiv);
                        }

                        // Setup Content Blocks
                        contentBlocks.forEach(b => {
                            if (!b.text || !b.text.trim()) return;
                            let tText = b.text.trim();
                            let convertedText = (typeof unicodeToGopika === 'function') ? unicodeToGopika(tText) : tText;
                            
                            let baseFontSize = (b.font_size || 11) * PT_TO_PX;
                            let bFontWeight = b.font_weight || 'normal';
                            let baseFontFamily = (bFontWeight === 'bold' || bFontWeight === '900') ? 'BGOTB' : 'BGOT';
                            let baseAlign = b.text_align || 'justify';
                            
                            let paragraphs = convertedText.split(/\r?\n/);
                            paragraphs.forEach(pText => {
                                if (!pText.trim()) return;
                                let p = document.createElement('p');
                                p.className = 'ad-paragraph';
                                p.contentEditable = "true";
                                p.style.outline = "none";
                                p.style.fontSize = baseFontSize + 'px';
                                p.style.fontFamily = baseFontFamily;
                                p.style.fontWeight = 'normal';
                                p.style.lineHeight = window.customLineHeight || 1.15;
                                p.style.textAlign = baseAlign;
                                if(baseAlign === 'force-justify') {
                                    p.style.textAlignLast = 'justify';
                                }

                                // Date Line check
                                if (pText.includes('તા:') || pText.includes('તારીખ')) {
                                    p.className = 'notice-date';
                                }

                                p.innerText = pText;
                                colsContainer.appendChild(p);
                            });
                        });

                        // Advocate Blocks
                        if (advocateBlocks.length > 0) {
                            let advWrapper = document.createElement('div');
                            advWrapper.className = 'advocate-block';
                            advocateBlocks.forEach(b => {
                                let rawAdvText = (b.text || '').trim();
                                let convertedAdv = (typeof unicodeToGopika === 'function') ? unicodeToGopika(rawAdvText) : rawAdvText;
                                let baseFontSize = (b.font_size || 12) * PT_TO_PX;
                                let defaultW = b.font_weight || 'normal';
                                let advBaseFont = (defaultW === 'bold' || defaultW === '900') ? 'BGOTB' : 'BGOT';

                                let paragraphs = convertedAdv.split(/\r?\n/);
                                paragraphs.forEach(pText => {
                                    if (!pText.trim()) return;
                                    let p = document.createElement('p');
                                    p.contentEditable = "true";
                                    p.style.outline = "none";
                                    p.style.fontSize = baseFontSize + 'px';
                                    p.style.fontFamily = advBaseFont;
                                    p.style.lineHeight = window.customLineHeight || 1.15;
                                    p.innerText = pText;
                                    advWrapper.appendChild(p);
                                });
                            });
                            colsContainer.appendChild(advWrapper);
                        }



                        container.appendChild(colsContainer);
                        
                        // Draw Manual Column Rules
                        if (colCount > 1 && window.columnRuleWidth > 0) {
                            let ruleWidthPx = Math.max(1, Math.round(window.columnRuleWidth * DPI_SCALE));
                            for (let i = 1; i < colCount; i++) {
                                let ruleDiv = document.createElement('div');
                                ruleDiv.style.position = 'absolute';
                                ruleDiv.style.top = '0px';
                                ruleDiv.style.bottom = '0px';
                                ruleDiv.style.width = ruleWidthPx + 'px';
                                ruleDiv.style.backgroundColor = '#000';
                                // Calculate position
                                let percent = (i / colCount) * 100;
                                ruleDiv.style.left = `calc(${percent}% - ${ruleWidthPx / 2}px)`;
                                container.appendChild(ruleDiv);
                            }
                        }

                        setTimeout(() => {
                            let currentH = container.offsetHeight;
                            let actualCmHeight = Math.round(((currentH / BASE_DPI) * 2.54) * 10) / 10;

                            if (!window.customBorderHeight) {
                                window.customBorderHeight = currentH;
                                window.customAdHeight = actualCmHeight;
                                const hInput = document.getElementById('adHeightInput');
                                if (hInput) hInput.value = actualCmHeight.toFixed(1);
                            }
                            
                            const badge = document.getElementById('advtMetaBadge');
                            if (badge) badge.innerText = `${advtData.advt_type || 'Legal Notice'} (${widthInCm.toFixed(1)}x${actualCmHeight.toFixed(1)} cm)`;

                            // Update Fabric log variables so zooming math keeps working
                            if (fabricCanvas) {
                                fabricCanvas._logW = container.offsetWidth;
                                fabricCanvas._logH = container.offsetHeight;
                            } else {
                                window._htmlLogW = container.offsetWidth;
                                window._htmlLogH = container.offsetHeight;
                            }

                            applyCanvasZoom();
                        }, 50);
                    }
                } catch (e) {
                    console.error("HTML render error:", e);
                }
            }
        }

        function setupCanvasEvents() { }
        function showFloatingLineToolbar(e) { }
        function hideFloatingLineToolbar() { }
        function setFloatingLineAlign(alignMode) { }
        function toggleFloatingLineBold() { }

        function updateCanvasFromText() {
            const container = document.getElementById('editBlocksContainer');
            const inputs = container.querySelectorAll('.block-editor-input');
            if (!advtData) return;

            try {
                let parsedData = JSON.parse(advtData.translated_text || '[]');
                let blocks = [];
                if (Array.isArray(parsedData)) blocks = parsedData;
                else if (parsedData && Array.isArray(parsedData.gujarati_text)) blocks = parsedData.gujarati_text;

                if (inputs.length === blocks.length) {
                    inputs.forEach((ta, idx) => {
                        blocks[idx].text = ta.value;
                        const parent = ta.parentElement;
                        const sizeInput = parent.querySelector('.block-format-size');
                        if (sizeInput) blocks[idx].font_size = parseFloat(sizeInput.value);
                        const boldInput = parent.querySelector('.block-format-bold-val');
                        if (boldInput) blocks[idx].font_weight = boldInput.value;
                        const alignInput = parent.querySelector('.block-format-align-val');
                        if (alignInput) blocks[idx].text_align = alignInput.value;
                    });

                    const hBgHeight = parseFloat(document.getElementById('headingHeightInput').value) || 25;
                    const hTextY = parseFloat(document.getElementById('headingTextYInput').value) || 0;
                    const hBlock = blocks.find(b => (b.type || '').toLowerCase() === 'heading');
                    if (hBlock) {
                        hBlock.bg_height = hBgHeight;
                        hBlock.text_offset_y = hTextY;
                        const hLayoutInput = document.querySelector('.block-format-layout-val');
                        if (hLayoutInput) hBlock.layout_position = hLayoutInput.value;
                    }

                    let newJson = {
                        gujarati_text: blocks,
                        layout_offset: window.currentLayoutOffset || 0,
                        border_height: window.customBorderHeight || null,
                        ad_width: window.customAdWidth || (window.customColumnCount * 4.0),
                        ad_height: window.customAdHeight || 8.0,
                        column_count: window.customColumnCount || 2,
                        col_widths: window.customColWidths,
                        column_rule_width: window.columnRuleWidth,
                        line_height: window.customLineHeight || 1.15,
                        char_spacing: window.customCharSpacing || 0,
                        word_spacing: window.customWordSpacing || 0
                    };

                    const newJsonStr = JSON.stringify(newJson);
                    document.getElementById('editTranslationText').value = newJsonStr;
                    advtData.translated_text = newJsonStr;

                    buildCanvasPreview();
                }
            } catch (e) {
                console.error("Error updating HTML from text:", e);
            }
        }

        async function saveEditorChanges() {
            const newJsonStr = document.getElementById('editTranslationText').value;
            try {
                const res = await fetch(`/api/advt/${CURRENT_ADVT_ID}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ translated_text: newJsonStr })
                });
                if (!res.ok) throw new Error("Failed to save changes");
                document.getElementById('saveStatusIndicator').innerText = "Saved successfully!";
                setTimeout(() => {
                    document.getElementById('saveStatusIndicator').innerText = "Auto-sync enabled";
                }, 3000);
            } catch (err) {
                alert("Save error: " + err.message);
            }
        }

        // High-DPI Smooth Unlimited Zoom & Pan (10% to 1000%+)
        function applyCanvasZoom() {
            const zoom = window.canvasZoom || 1.0;
            const displayRatio = 0.45;
            const effectiveZoom = zoom * displayRatio;

            const htmlWrapper = document.getElementById('advtHtmlWrapper');
            const htmlContainer = document.getElementById('advtHtmlContainer');
            if (htmlWrapper && htmlContainer) {
                htmlWrapper.style.transform = `scale(${effectiveZoom})`;
                
                const cssWidth = htmlContainer.offsetWidth * effectiveZoom;
                const cssHeight = htmlContainer.offsetHeight * effectiveZoom;
                
                const inner = document.getElementById('canvasInner');
                if (inner) {
                    inner.style.width = cssWidth + 'px';
                    inner.style.height = cssHeight + 'px';
                }
            }
        }

        function setCanvasZoom(z) {
            window.canvasZoom = Math.max(0.1, Math.min(10.0, z));
            updateZoomButtons();
            applyCanvasZoom();
        }

        function zoomStep(delta) {
            setCanvasZoom(window.canvasZoom + delta);
        }

        function setCanvasZoomPreset(z) {
            setCanvasZoom(z);
        }

        function onZoomSliderInput(val) {
            setCanvasZoom(parseFloat(val) / 100);
        }

        function onZoomInputPercent(val) {
            setCanvasZoom((parseFloat(val) || 100) / 100);
        }

        function updateZoomButtons() {
            const percent = Math.round(window.canvasZoom * 100);
            document.getElementById('zoomRangeSlider').value = Math.min(500, percent);
            document.getElementById('zoomPercentInput').value = percent;
        }

        function fitCanvasToWidth() {
            const area = document.getElementById('canvasScrollArea');
            let logW = window._htmlLogW;
            if (fabricCanvas && fabricCanvas._logW) logW = fabricCanvas._logW;
            if (!area || !logW) return;
            const availW = area.clientWidth - 80;
            const fitZoom = (availW / (logW * 0.45));
            setCanvasZoom(fitZoom);
        }

        function fitCanvasToPage() {
            const area = document.getElementById('canvasScrollArea');
            let logH = window._htmlLogH;
            if (fabricCanvas && fabricCanvas._logH) logH = fabricCanvas._logH;
            if (!area || !logH) return;
            const availH = area.clientHeight - 80;
            const fitZoom = (availH / (logH * 0.45));
            setCanvasZoom(fitZoom);
        }

        // Ctrl + Wheel Zooming Event
        document.getElementById('canvasScrollArea').addEventListener('wheel', function (e) {
            if (e.ctrlKey) {
                e.preventDefault();
                const delta = e.deltaY < 0 ? 0.05 : -0.05;
                setCanvasZoom(window.canvasZoom + delta);
            }
        }, { passive: false });

        // Download PNG, PDF, TIF High-Res Export
        async function downloadCanvas(format) {
            await ensureFontsLoaded();
            const container = document.getElementById('advtHtmlContainer');
            if(!container) return;

            const wrapper = document.getElementById('advtHtmlWrapper');
            const originalTransform = wrapper.style.transform;
            const originalTransformOrigin = wrapper.style.transformOrigin;
            
            // Temporarily remove transform to capture full resolution
            wrapper.style.transform = 'scale(1)';
            wrapper.style.transformOrigin = 'top left';

            // Generate canvas using html2canvas
            const canvas = await html2canvas(container, {
                scale: 1, // Already scaled physically via BASE_DPI=300
                useCORS: true,
                backgroundColor: '#ffffff',
                logging: false
            });

            // Restore transform
            wrapper.style.transform = originalTransform;
            wrapper.style.transformOrigin = originalTransformOrigin;

            let dataURL = canvas.toDataURL('image/png', 1.0);

            if (format === 'png') {
                const a = document.createElement('a');
                a.href = dataURL;
                a.download = `ADVT_${CURRENT_ADVT_ID}.png`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            } else if (format === 'pdf') {
                const { jsPDF } = window.jspdf;
                let finalWidth = window.customAdWidth;
                let finalHeight = (canvas.height / BASE_DPI) * 2.54;
                const pdf = new jsPDF({ orientation: 'portrait', unit: 'cm', format: [finalWidth, finalHeight] });
                pdf.addImage(dataURL, 'PNG', 0, 0, finalWidth, finalHeight);
                pdf.save(`ADVT_${CURRENT_ADVT_ID}.pdf`);
            } else if (format === 'tif') {
                alert("TIF Export ready: PNG generated with 300 DPI metadata!");
                const a = document.createElement('a');
                a.href = dataURL;
                a.download = `ADVT_${CURRENT_ADVT_ID}.tif`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            }
        }

        // DOM Ready Load
        document.addEventListener('DOMContentLoaded', () => {
            loadAdData();
        });
    </script>
</body>

</html>
